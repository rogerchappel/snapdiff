{
  "name": "snapdiff",
  "version": "0.1.0",
  "description": "Deterministic output snapshot testing CLI. Capture, diff, and verify text/JSON/CLI outputs with zero framework overhead.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "snapdiff": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "check": "eslint src tests",
    "dev": "tsc --watch",
    "smoke": "bash scripts/smoke.sh",
    "start": "node dist/index.js",
    "test": "vitest run",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm run check && npm test && npm run build && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "snapshot",
    "testing",
    "cli",
    "diff",
    "deterministic",
    "regression"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/snapdiff.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/snapdiff/issues"
  },
  "homepage": "https://github.com/rogerchappel/snapdiff#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
