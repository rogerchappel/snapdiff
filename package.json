{
  "name": "@rogerchappel/snapdiff",
  "version": "0.1.0",
  "description": "Deterministic output snapshot testing CLI. Capture, diff, and verify text/JSON/CLI outputs with zero framework overhead.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "snapdiff": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "eslint src tests",
    "docs:check": "node scripts/check-package-docs.mjs",
    "dev": "tsc --watch",
    "smoke": "bash scripts/smoke.sh",
    "start": "node dist/index.js",
    "test": "vitest run",
    "audit": "npm audit --audit-level=low",
    "package:smoke": "bash scripts/package-smoke.sh",
    "release:check": "npm run check && npm run docs:check && npm test && npm run build && npm run smoke && npm run audit && npm run package:smoke"
  },
  "keywords": [
    "snapshot",
    "testing",
    "cli",
    "diff",
    "deterministic",
    "regression"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/snapdiff.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/snapdiff/issues"
  },
  "homepage": "https://github.com/rogerchappel/snapdiff#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "postcss": "8.5.23"
  }
}
